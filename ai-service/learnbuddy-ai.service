[Unit]
Description=LearnBuddy AI context-explanation service (pi SDK behind /ai proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runtime identity is the unprivileged `learnbuddy` system user (ADR 0010):
# code is immutable in /opt, auth/config/cache live in /var/lib (seeded once
# by hand, never synced by deploy.sh). HOME is /var/lib/learnbuddy, so the
# default agent dir would resolve sanely — the explicit env below pins it.
WorkingDirectory=/opt/learnbuddy/ai
User=learnbuddy
Group=learnbuddy
Environment=LEARNBUDDY_AI_AGENT_DIR=/var/lib/learnbuddy/ai-agent
# Chat (ticket #47) upgrades pi past the one-shot explainer: pin the agent
# dir for pi itself too — without a TTY it silently degrades to print mode
# when this is unset (spec §7).
Environment=PI_CODING_AGENT_DIR=/var/lib/learnbuddy/ai-agent
ExecStart=/usr/bin/node /opt/learnbuddy/ai/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/learnbuddy/ai-agent
ProtectHome=true

[Install]
WantedBy=multi-user.target
