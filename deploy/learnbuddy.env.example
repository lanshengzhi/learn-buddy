# LearnBuddyclaw runtime config (ADR 0010). Managed by scripts/deploy.sh:
# created once, never overwritten (your edits survive deploys).
# The AI explainer listens on loopback only; the LAN never reaches it.
LEARNBUDDY_AI_URL=http://127.0.0.1:8123
# Uncomment to make Azure the primary TTS provider (ADR 0005);
# unset (or absent key) means Edge TTS with automatic fallback.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=japaneast
